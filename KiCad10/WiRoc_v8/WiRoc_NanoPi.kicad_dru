(version 1)

(rule "emmc cmd"
      (condition "A.hasNetclass('eMMC-Cmd')")
      (constraint length (min 95ps) (opt 100ps) (max 145ps))
)

(rule "emmc clk"
      (condition "A.hasNetclass('eMMC-Clk')")
      (constraint length (min 95ps) (opt 100ps) (max 125ps))
      (constraint skew (max 15ps))
)

(rule "emmc clk 2"
      (condition "A.hasNetclass('eMMC-CLK-2')")
      (constraint length (min 0ps) (opt 10ps) (max 30ps))
)

(rule "wifi signals"
      (condition "A.hasNetclass('WIFI-SPI')")
      (constraint length (min 340ps) (opt 350ps) (max 385ps))
)

(rule "ddr3 data)"
      (condition "A.hasNetclass('DDR3-Data')")
      (constraint length (min 99ps) (opt 100ps) (max 114ps))
)

(rule "ddr3 data ctrl 1"
      (condition "A.hasNetclass('DDR3-DP-SDQS0')")
      (constraint length (min 100ps) (opt 110ps) (max 120ps))
      (constraint skew (max 1ps) (within_diff_pairs))
)

(rule "ddr3 data ctrl 2"
      (condition "A.hasNetclass('DDR3-DP-SDQS1')")
      (constraint length (min 100ps) (opt 110ps) (max 120ps))
      (constraint skew (max 1ps) (within_diff_pairs))
)

(rule "DDR address delay match"
  (constraint length (min 100ps) (opt 110ps) (max 120ps))
  (condition "A.hasNetclass('DDR3-Address')")
)

(rule "ddr3 clock"
    (condition "A.hasNetclass('DDR3-DP-SCK')")
    (constraint length (min 130ps) (opt 140ps) (max 150ps))
    (constraint skew (max 1ps) (within_diff_pairs))
)

(rule "Ethernet_Diff_Pair_Skew"
    (constraint skew (max 6ps) (within_diff_pairs))
    (condition "A.hasNetclass('Ethernet-DP')")
)
